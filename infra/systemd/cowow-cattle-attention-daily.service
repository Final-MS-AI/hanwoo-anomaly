[Unit]
Description=COWOW daily cattle attention analysis
After=network-online.target hanwoo-fastapi.service
Wants=network-online.target

[Service]
Type=oneshot
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/hanwoo-anomaly/backend
EnvironmentFile=/home/azureuser/3rd_fastapi/.env
ExecStart=/home/azureuser/3rd_fastapi/venv/bin/python /home/azureuser/hanwoo-anomaly/backend/run_cattle_attention_analysis.py --all-active
