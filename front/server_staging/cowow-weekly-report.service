[Unit]
Description=COWOW weekly barn operations email report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/hanwoo-anomaly/backend
EnvironmentFile=/home/azureuser/3rd_fastapi/.env
ExecStart=/home/azureuser/3rd_fastapi/venv/bin/python /home/azureuser/hanwoo-anomaly/backend/scheduled_report_mailer.py
